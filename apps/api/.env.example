PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/planejador_bncc?schema=public"

JWT_ACCESS_SECRET="dev-jwt-access-secret-min-32-chars-replace-in-prod"
JWT_ACCESS_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION_DAYS=7
COOKIE_SECURE=false
CORS_ORIGIN="http://localhost:3000"

# Integração com n8n (em desenvolvimento/teste o mock permanece ativado)
N8N_MOCK_ENABLED=true
N8N_TIMEOUT_MS=60000
N8N_WEBHOOK_URL="http://localhost:5678/webhook/gerar-plano"
N8N_API_KEY="dev-n8n-api-key"
